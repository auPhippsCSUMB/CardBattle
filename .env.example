# Default docker-compose.yml uses the existing Railway database.
# Copy real values from your private backend .env; use the public Railway host/port.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_RAILWAY_PUBLIC_HOST:YOUR_PUBLIC_PORT/railway
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-railway-password

GOOGLE_SERVER_CLIENT_ID=replace-with-google-client-id
# Keep 8080 for the Android emulator's existing backend URL.
APP_PORT=8080

# Only used with docker-compose.local.yml. No Railway data is copied into this database.
POSTGRES_DB=cardbattle
POSTGRES_USER=cardbattle
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
